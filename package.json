{
  "name": "web-app-typst",
  "version": "0.3.0",
  "description": "Typst editor with live preview and PDF export for ownCloud Infinite Scale.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm fonts && pnpm vite build",
    "build:w": "pnpm fonts && pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@ownclouders/eslint-config": "12.5.1",
    "@ownclouders/extension-sdk": "12.5.1",
    "@ownclouders/prettier-config": "0.0.2",
    "@ownclouders/tsconfig": "0.0.7",
    "@ownclouders/web-client": "^13.0.0",
    "@ownclouders/web-pkg": "^13.0.0",
    "@types/node": "26.6.6",
    "@vue/test-utils": "^2.5.1",
    "eslint": "9.39.4",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "7.2.2",
    "vitest": "5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "3.3.14",
    "vue3-gettext": "^4.0.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "design-system*"
      ]
    },
    "overrides": {
      "glob": "^10.5.0"
    }
  },
  "packageManager": "pnpm@10.34.1"
}
